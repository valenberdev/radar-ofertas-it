# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Pooled connection (PgBouncer). Used by the app at runtime.
# Locally there is no pooler, so it points to the same database as the direct URL.
DATABASE_URL=postgresql://radar:radar@127.0.0.1:5435/radar

# Direct connection. Used by migrations.
DATABASE_URL_UNPOOLED=postgresql://radar:radar@127.0.0.1:5435/radar