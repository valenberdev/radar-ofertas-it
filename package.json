{
  "name": "radar-ofertas-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:smoke": "vitest run --config vitest.smoke.config.mts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate/run.mts",
    "db:migrate:prod": "node --env-file=.env.production.local scripts/migrate/run.mts",
    "eval:personas": "tsx --env-file-if-exists=.env.local scripts/eval/extract-personas.mts",
    "eval:snapshot": "tsx --env-file-if-exists=.env.local scripts/eval/export-snapshot.mts",
    "eval:snapshot:prod": "tsx --env-file=.env.production.local scripts/eval/export-snapshot.mts",
    "eval:label": "tsx scripts/eval/build-labeling.mts",
    "eval:retest": "tsx scripts/eval/build-labeling.mts --retest",
    "eval:agreement": "tsx scripts/eval/report-agreement.mts"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
