{
  "name": "radar-ofertas-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate/run.mts",
    "db:migrate:prod": "node --env-file=.env.production.local scripts/migrate/run.mts",
    "db:renormalize": "tsx --env-file-if-exists=.env.local scripts/renormalize.mts",
    "db:renormalize:prod": "tsx --env-file=.env.production.local scripts/renormalize.mts"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
